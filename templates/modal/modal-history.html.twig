{#
/**
 * @file
 * Hộp thoại hiển thị hành trình của một bưu gửi.
 *
 * Nội dung được nạp bằng JavaScript khi người dùng mở hộp thoại.
 */
#}
<div class="modal fade" id="historyShippingOrderModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="mb-0 fs-5">
					{{ "Tracking history"|t }}
					<span class="shipping-history-code text-muted fs-6"></span>
				</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ "Close"|t }}"></button>
			</div>
			{# Hai góc nhìn khác nhau: hành trình do hãng ghi, nhật ký do hệ thống ghi. #}
			<ul class="nav nav-tabs px-3 pt-2" role="tablist">
				<li class="nav-item" role="presentation">
					<button class="nav-link active" data-bs-toggle="tab" data-bs-target="#shippingHistoryPane" type="button" role="tab">
						{{ "Carrier tracking"|t }}
					</button>
				</li>
				<li class="nav-item" role="presentation">
					<button class="nav-link shipping-log-tab" data-bs-toggle="tab" data-bs-target="#shippingLogPane" type="button" role="tab">
						{{ "System log"|t }}
					</button>
				</li>
			</ul>
			<div class="modal-body tab-content">
				<div class="tab-pane fade show active shipping-history-body" id="shippingHistoryPane" role="tabpanel">
					<p class="text-muted mb-0">{{ "Loading..."|t }}</p>
				</div>
				<div class="tab-pane fade shipping-log-body" id="shippingLogPane" role="tabpanel">
					<p class="text-muted mb-0">{{ "Loading..."|t }}</p>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ "Close"|t }}</button>
			</div>
		</div>
	</div>
</div>
