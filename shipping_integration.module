<?php

/**
 * @file
 * Tích hợp các hãng vận chuyển và quản lý đơn hàng trong nước.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Render\Element;
use Drupal\shipping_integration\Service\GetConfigShipping;

/**
 * Implements hook_theme().
 */
function shipping_integration_theme(): array {
  return [
    'shipping_address' => ['render element' => 'elements'],
    'shipping_order' => ['render element' => 'elements'],
    'shipping_type' => ['render element' => 'elements'],
    'list_shipping_order' => [
      'template' => 'list-shipping-order',
      'variables' => [
        'data' => [],
        'filter' => [],
      ],
    ],
    'detail_shipping_order' => [
      'template' => 'detail-shipping-order',
      'variables' => [
        'data' => [],
        'filter' => [],
      ],
    ],
  ];
}

/**
 * Prepares variables for shipping address templates.
 *
 * Default template: shipping-address.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing
 *     the shipping address information and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_shipping_address(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Prepares variables for shipping order templates.
 *
 * Default template: shipping-order.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the shipping order information
 *     and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_shipping_order(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Prepares variables for shipping type templates.
 *
 * Default template: shipping-type.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the shipping type information
 *     and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_shipping_type(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements hook_entity_presave().
 *
 * Mỗi lần người dùng sửa term cấu hình kết nối là một lần tài khoản hoặc host
 * có thể đã đổi, nên lấy luôn token mới thay vì chờ tới lệnh gọi API đầu tiên
 * mới phát hiện sai. Cờ skip_call_token để dịch vụ tự lưu token không kích
 * hoạt lại vòng lặp này.
 */
function shipping_integration_entity_presave(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'taxonomy_term'
    || $entity->bundle() !== GetConfigShipping::VOCABULARY
    || !empty($entity->skip_call_token)
  ) {
    return;
  }

  /** @var \Drupal\taxonomy\TermInterface $entity */
  \Drupal::service('shipping_integration.get_config')->refreshToken($entity);
}

/**
 * Implements hook_ENTITY_TYPE_insert() for taxonomy_term.
 */
function shipping_integration_taxonomy_term_insert(EntityInterface $entity): void {
  _shipping_integration_flush_local_actions($entity);
}

/**
 * Implements hook_ENTITY_TYPE_update() for taxonomy_term.
 */
function shipping_integration_taxonomy_term_update(EntityInterface $entity): void {
  _shipping_integration_flush_local_actions($entity);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for taxonomy_term.
 */
function shipping_integration_taxonomy_term_delete(EntityInterface $entity): void {
  _shipping_integration_flush_local_actions($entity);
}

/**
 * Dựng lại các nút đồng bộ địa chỉ khi danh sách cấu hình kết nối đổi.
 *
 * Định nghĩa local action được cache mà không gắn cache tag nào, nên thêm hay
 * đổi tên một term cấu hình sẽ không tự hiện ra nút tương ứng.
 *
 * @param EntityInterface $entity
 *   Term vừa được lưu hoặc xoá.
 */
function _shipping_integration_flush_local_actions(EntityInterface $entity): void {
  if ($entity->bundle() === GetConfigShipping::VOCABULARY) {
    \Drupal::service('plugin.manager.menu.local_action')->clearCachedDefinitions();
  }
}
